{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "motd-studio",
  "color": "#16a34a",
  "category": "games",
  "name": {
    "de": "MOTD-Studio",
    "en": "MOTD studio"
  },
  "description": {
    "de": "Die Beschreibung deines Minecraft-Servers in der Serverliste gestalten – mit Farben, Verläufen, Platzhaltern (Name, Version, nächster Neustart …), mehreren Varianten, Vorlagen und einer Vorschau wie im Spiel. Direkt in der Übersicht jedes Minecraft-Servers, dazu ein großer Editor.",
    "en": "Design your Minecraft server’s description in the server list – with colours, gradients, placeholders (name, version, next restart …), several variants, templates and a preview like in the game. Right in the overview of every Minecraft server, plus a big editor."
  },
  "permissions": [
    "read:minecraft",
    "read:tasks",
    "change:minecraft",
    "control:services",
    "storage"
  ],
  "page": {
    "title": {
      "de": "MOTD-Studio",
      "en": "MOTD studio"
    },
    "description": {
      "de": "Beschreibung und Symbol in der Serverliste gestalten – Farben, Vorlagen, Vorschau. Speichern und Neustart fragen vorher.",
      "en": "Design the description and icon in the server list – colours, templates, preview. Saving and restarting ask first."
    },
    "icon": "sparkles",
    "file": "page/index.html",
    "tabs": [
      {
        "id": "editor",
        "title": {
          "de": "Editor",
          "en": "Editor"
        },
        "icon": "wand"
      },
      {
        "id": "codes",
        "title": {
          "de": "Farbcodes",
          "en": "Colour codes"
        },
        "icon": "list"
      }
    ],
    "nav": false
  },
  "contributes": {
    "sections": [
      {
        "id": "motd",
        "title": {
          "de": "MOTD-Studio",
          "en": "MOTD studio"
        },
        "icon": "sparkles",
        "on": "mc.overview",
        "file": "page/section.html",
        "height": 720,
        "role": "motd"
      }
    ],
    "tabs": [
      {
        "id": "motd",
        "title": {
          "de": "MOTD",
          "en": "MOTD"
        },
        "icon": "sparkles",
        "on": "minecraft",
        "file": "page/tab.html",
        "fallback": true
      }
    ],
    "actions": [
      {
        "id": "edit",
        "title": {
          "de": "MOTD gestalten …",
          "en": "Design MOTD …"
        },
        "icon": "sparkles",
        "on": [
          "minecraft",
          "palette"
        ]
      }
    ]
  },
  "version": "1.4.1",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-motd-studio",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "hostwerk": ">=2.11.0",
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  }
}
